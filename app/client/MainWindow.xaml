<Window x:Class="NekoDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="nekodrop" Width="420" Height="700"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" AllowDrop="True"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="44"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="WifiButton" Style="{StaticResource TitleButton}" Width="Auto" Padding="8,0" Click="Wifi_Click" ToolTip="Wi-Fi">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="13" Margin="0,0,6,0"/>
              <TextBlock x:Name="WifiText" FontSize="12" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TitleButton}" Click="Settings_Click" ToolTip="{local:T main.settings}"
                  AutomationProperties.Name="{local:T main.settings}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14"/>
          </Button>
          <Border Width="1" Height="14" Background="{DynamicResource Border}" Margin="4,0"/>
          <Button Style="{StaticResource TitleButton}" Click="Close_Click" AutomationProperties.Name="Close">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The AirDrop mark: who can send to this PC (off, contacts, everyone), as on an iPhone -->
          <Button x:Name="MarkButton" Style="{StaticResource TitleButton}" Width="30" Height="30" Margin="-6,0,2,0" Click="Mark_Click"
                  AutomationProperties.Name="{local:T recv.title}">
            <local:AirDropMark x:Name="Mark" Width="18" Height="18" Brush="{DynamicResource Accent}"/>
          </Button>
          <TextBlock Text="nekodrop" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <!-- Status pill: opens the quick controls -->
          <ToggleButton x:Name="StatusPill" shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Checked="StatusPill_Checked">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="b" CornerRadius="12" Padding="10,4" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Text}" MaxWidth="150"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource Text3}" Margin="6,1,0,0"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Who can send to this PC, under the AirDrop mark -->
    <Popup x:Name="ReceivePopup" PlacementTarget="{Binding ElementName=MarkButton}" Placement="Bottom" VerticalOffset="6"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Width="264" CornerRadius="12" Padding="12" Background="{DynamicResource MicaSolid}" BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="{local:T recv.title}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel x:Name="ReceiveList"/>
          <TextBlock x:Name="ReceiveTip" Style="{StaticResource Dim11}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Quick controls under the status pill -->
    <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=StatusPill}" Placement="Bottom" VerticalOffset="6"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="StatusPopup_Closed">
      <Border Width="264" CornerRadius="12" Padding="12" Background="{DynamicResource MicaSolid}" BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18"/></Border.Effect>
        <StackPanel>
          <DockPanel>
            <CheckBox x:Name="AllowToggle" DockPanel.Dock="Right" Style="{StaticResource WinToggle}" Click="Allow_Click"/>
            <TextBlock Text="{local:T tray.receive}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <CheckBox x:Name="AutoAcceptToggle" DockPanel.Dock="Right" Style="{StaticResource WinToggle}" Click="AutoAccept_Click"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="{local:T tray.autoAccept}" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock x:Name="AutoAcceptSub" Style="{StaticResource Dim11}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Rule}" Margin="0,10,0,8"/>
          <TextBlock Text="{local:T tray.mode}" Style="{StaticResource Dim11}" Margin="0,0,0,4"/>
          <StackPanel x:Name="ModeList"/>
          <Border Style="{StaticResource Rule}" Margin="0,8,0,8"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T tray.report}" Click="Report_Click" FontSize="11"/>
            <TextBlock x:Name="ChannelTip" Style="{StaticResource Dim11}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Popup>


    <!-- Content -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,12,16,12">
        <!-- Nearby devices -->
        <local:RadarView Height="420"/>

        <!-- Files to send: dashed while empty -->
        <Grid Margin="0,12,0,0">
          <Rectangle x:Name="FilesOutline" RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                     Fill="{DynamicResource Card}"/>
          <StackPanel Margin="12,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource WinButton}" Content="{local:T main.add}" Click="Add_Click" Padding="10,5"/>
                <Button x:Name="ClearButton" Style="{StaticResource QuietButton}" Content="{local:T main.clear}" Click="Clear_Click" Margin="4,0,0,0"/>
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Text2}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{local:T main.dropHint}" FontSize="12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
            <DockPanel x:Name="FilesRow" Margin="0,8,0,0">
              <TextBlock x:Name="FilesCount" DockPanel.Dock="Right" Style="{StaticResource Dim11}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            CornerRadius="6" Padding="10,3,4,3" Margin="0,0,6,6" ToolTip="{Binding}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Converter={x:Static local:FileName.Instance}}" FontSize="12" MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TitleButton}" Width="20" Height="20" Tag="{Binding}" Click="RemoveFile_Click" Margin="4,0,0,0"
                                AutomationProperties.Name="Remove">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"/>
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </StackPanel>
        </Grid>

        <!-- Recent transfers: received / sent switcher + all history link -->
        <DockPanel Margin="0,12,0,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T main.allHistory}"
                  Click="History_Click" VerticalAlignment="Center" FontSize="12"/>
          <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RecentReceivedTab" Style="{StaticResource Segment}" Content="{local:T main.received}"
                           GroupName="recentTab" IsChecked="True" Checked="RecentTab_Checked"/>
              <RadioButton x:Name="RecentSentTab" Style="{StaticResource Segment}" Content="{local:T main.sent}"
                           GroupName="recentTab" Checked="RecentTab_Checked"/>
            </StackPanel>
          </Border>
        </DockPanel>
        <TextBlock x:Name="NothingReceived" Text="{local:T main.receivedNone}" Style="{StaticResource Dim11}" FontSize="12" Margin="2,2,0,4"/>
        <ItemsControl x:Name="ReceivedList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:TransferRecord">
              <Border x:Name="card" Style="{StaticResource WinCard}" Padding="10,7" Margin="0,0,0,6" ToolTip="{Binding TooltipText}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="copy" Style="{StaticResource TitleButton}" Width="26" Height="26"
                            Tag="{Binding}" Click="Copy_Click" ToolTip="{local:T hist.copy}" Margin="0,0,4,0">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/>
                    </Button>
                    <Button x:Name="open" Style="{StaticResource WinButton}" Content="{local:T main.open}"
                            Tag="{Binding}" Click="Open_Click" Padding="10,4" FontSize="11"/>
                  </StackPanel>
                  <TextBlock x:Name="glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run Text="{Binding PeerLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · " Foreground="{DynamicResource Text3}"/><Run
                         Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Text2}"/><Run Text=" · " Foreground="{DynamicResource Text3}"/><Run
                         x:Name="tail" Text="{Binding WhenText, Mode=OneWay}" Foreground="{DynamicResource Text3}"/>
                  </TextBlock>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanCopy}" Value="False">
                  <Setter TargetName="copy" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanOpen}" Value="False">
                  <Setter TargetName="open" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                  <Setter TargetName="open" Property="Content" Value="{local:T hist.openLink}"/>
                  <Setter TargetName="copy" Property="ToolTip" Value="{local:T hist.copyLink}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="copy" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="open" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Error}"/>
                  <Setter TargetName="tail" Property="Text" Value="{Binding StatusText, Mode=OneWay}"/>
                  <Setter TargetName="tail" Property="Foreground" Value="{DynamicResource Error}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: where received files go -->
    <Border Grid.Row="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource LinkButton}" Content="{local:T main.change}" Click="ChangeFolder_Click"/>
          <Button Style="{StaticResource LinkButton}" Content="{local:T main.openFolder}" Click="OpenFolder_Click" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,0,8,0"/>
          <TextBlock x:Name="FolderText" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" MaxWidth="200"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
